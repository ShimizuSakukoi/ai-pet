# ========================================
# AI Pet 配置文件
# ========================================
# 将此文件复制一份，重命名为 .env
# 然后填入你自己的 API Key

# -------------------------------
# 选择提供商：deepseek / openai / custom
# custom 可用于任何兼容 OpenAI 格式的服务（通义千问、智谱、Ollama 等）
# -------------------------------
LLM_PROVIDER=deepseek

# -------------------------------
# DeepSeek（推荐，注册即送 500 万 token）
# 获取地址：https://platform.deepseek.com/api_keys
# -------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# -------------------------------
# OpenAI
# 获取地址：https://platform.openai.com/api_keys
# -------------------------------
OPENAI_API_KEY=sk-your-openai-key-here

# -------------------------------
# 自定义（兼容 OpenAI 格式的任何服务）
# 例如 通义千问、智谱 GLM、Ollama 本地模型等
# 用法：将 LLM_PROVIDER 改为 custom，填下方
# -------------------------------
# CUSTOM_API_KEY=sk-your-custom-key-here
# CUSTOM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# -------------------------------
# 模型名称（根据提供商选择）
# DeepSeek:  deepseek-chat
# OpenAI:    gpt-4o / gpt-4o-mini / gpt-3.5-turbo
# 通义千问:  qwen-plus / qwen-turbo
# Ollama:    llama3 / qwen2.5
# -------------------------------
MODEL_NAME=deepseek-chat
